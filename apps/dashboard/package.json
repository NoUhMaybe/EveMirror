{
  "name": "eve-dashboard",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --configLoader runner",
    "build": "vite build --config vite.config.ts --configLoader runner",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -b",
    "preview": "vite preview --config vite.config.ts --configLoader runner --host 127.0.0.1",
    "contracts": "node scripts/contracts.mjs",
    "contracts:check": "node scripts/contracts.mjs --check",
    "format": "prettier --write src tests scripts vite.config.ts playwright.config.ts",
    "format:check": "prettier --check src tests scripts vite.config.ts playwright.config.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.173.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.173.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.25.12",
    "json-schema-to-typescript": "15.0.4",
    "prettier": "3.6.2",
    "typescript": "^5.7.3",
    "vite": "^6.4.3"
  },
  "engines": {
    "node": ">=24.4.0"
  }
}
