    "AckPayload": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "accepted",
            "completed",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "replayed": {
          "default": false,
          "title": "Replayed",
          "type": "boolean"
        },
        "code": {
          "default": "ok",
          "enum": [
            "ok",
            "unavailable",
            "invalid_ack",
            "indeterminate",
            "expired",
            "conflict",
            "busy"
          ],
          "title": "Code",
          "type": "string"
        },
        "hardware": {
          "$ref": "#/$defs/HardwareStatus"
        }
      },
      "required": [
        "status"
      ],
      "title": "AckPayload",
      "type": "object"
    },
