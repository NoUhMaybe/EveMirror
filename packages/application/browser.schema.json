{
  "$defs": {
    "AlarmDeliverySnapshot": {
      "properties": {
        "alarms": {
          "items": {
            "$ref": "#/$defs/AlarmDeliveryState"
          },
          "title": "Alarms",
          "type": "array"
        },
        "available": {
          "default": false,
          "title": "Available",
          "type": "boolean"
        }
      },
      "title": "AlarmDeliverySnapshot",
      "type": "object"
    },
    "AlarmDeliveryState": {
      "additionalProperties": false,
      "properties": {
        "alarm_id": {
          "format": "uuid",
          "title": "Alarm Id",
          "type": "string"
        },
        "delivery_status": {
          "enum": [
            "pending",
            "delivered",
            "started",
            "completed",
            "cancelled",
            "failed",
            "indeterminate"
          ],
          "title": "Delivery Status",
          "type": "string"
        },
        "device_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Device Id",
          "type": "string"
        },
        "pending": {
          "title": "Pending",
          "type": "boolean"
        },
        "updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Updated At"
        }
      },
      "required": [
        "alarm_id",
        "device_id",
        "delivery_status",
        "updated_at",
        "pending"
      ],
      "title": "AlarmDeliveryState",
      "type": "object"
    },
    "AlarmRecord": {
      "additionalProperties": false,
      "properties": {
        "alarm_id": {
          "format": "uuid",
          "title": "Alarm Id",
          "type": "string"
        },
        "device_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Device Id",
          "type": "string"
        },
        "expired_at": {
          "format": "date-time",
          "title": "Expired At",
          "type": "string"
        },
        "timer_id": {
          "format": "uuid",
          "title": "Timer Id",
          "type": "string"
        }
      },
      "required": [
        "alarm_id",
        "timer_id",
        "device_id",
        "expired_at"
      ],
      "title": "AlarmRecord",
      "type": "object"
    },
    "ApplicationSnapshot": {
      "additionalProperties": false,
      "properties": {
        "alarms": {
          "items": {
            "$ref": "#/$defs/AlarmRecord"
          },
          "title": "Alarms",
          "type": "array"
        },
        "availability": {
          "additionalProperties": true,
          "title": "Availability",
          "type": "object"
        },
        "devices": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Devices",
          "type": "array"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "timers": {
          "items": {
            "$ref": "#/$defs/TimerRecord"
          },
          "title": "Timers",
          "type": "array"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "tools": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Tools",
          "type": "array"
        },
        "version": {
          "const": 1,
          "default": 1,
          "title": "Version",
          "type": "integer"
        },
        "views": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Views",
          "type": "array"
        },
        "weather": {
          "items": {
            "$ref": "#/$defs/Forecast"
          },
          "title": "Weather",
          "type": "array"
        }
      },
      "required": [
        "timestamp",
        "revision"
      ],
      "title": "ApplicationSnapshot",
      "type": "object"
    },
    "BrowserGrant": {
      "additionalProperties": false,
      "properties": {
        "captions": {
          "default": false,
          "title": "Captions",
          "type": "boolean"
        },
        "debug": {
          "default": false,
          "title": "Debug",
          "type": "boolean"
        },
        "display_control": {
          "default": false,
          "title": "Display Control",
          "type": "boolean"
        },
        "home_control": {
          "default": false,
          "title": "Home Control",
          "type": "boolean"
        },
        "home_entities": {
          "items": {
            "type": "string"
          },
          "title": "Home Entities",
          "type": "array",
          "uniqueItems": true
        },
        "timers": {
          "default": false,
          "title": "Timers",
          "type": "boolean"
        },
        "voice_control": {
          "default": false,
          "title": "Voice Control",
          "type": "boolean"
        }
      },
      "title": "BrowserGrant",
      "type": "object"
    },
    "BrowserHome": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": true,
          "title": "Attributes",
          "type": "object"
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "entity_id": {
          "title": "Entity Id",
          "type": "string"
        },
        "last_updated": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Updated"
        },
        "name": {
          "maxLength": 160,
          "title": "Name",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "power_off": {
          "title": "Power Off",
          "type": "boolean"
        },
        "power_on": {
          "title": "Power On",
          "type": "boolean"
        },
        "remote_commands": {
          "items": {
            "type": "string"
          },
          "title": "Remote Commands",
          "type": "array"
        },
        "source": {
          "const": "home-assistant",
          "title": "Source",
          "type": "string"
        },
        "state": {
          "maxLength": 160,
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "entity_id",
        "name",
        "state",
        "source",
        "observed_at",
        "last_updated",
        "attributes",
        "capabilities",
        "remote_commands",
        "power_on",
        "power_off"
      ],
      "title": "BrowserHome",
      "type": "object"
    },
    "BrowserSession": {
      "additionalProperties": false,
      "properties": {
        "csrf": {
          "title": "Csrf",
          "type": "string"
        },
        "device_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Device Id",
          "type": "string"
        },
        "expires_at": {
          "title": "Expires At",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "permissions": {
          "$ref": "#/$defs/BrowserGrant"
        }
      },
      "required": [
        "id",
        "device_id",
        "name",
        "expires_at",
        "csrf",
        "permissions"
      ],
      "title": "BrowserSession",
      "type": "object"
    },
    "Current": {
      "properties": {
        "condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Condition"
        },
        "feels_like": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Feels Like"
        },
        "humidity_pct": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Humidity Pct"
        },
        "kind": {
          "const": "model_estimate",
          "default": "model_estimate",
          "title": "Kind",
          "type": "string"
        },
        "precipitation": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Precipitation"
        },
        "temperature": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Temperature"
        },
        "time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Time"
        },
        "wind_speed": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Wind Speed"
        }
      },
      "required": [
        "time",
        "temperature",
        "feels_like",
        "humidity_pct",
        "wind_speed",
        "condition",
        "precipitation"
      ],
      "title": "Current",
      "type": "object"
    },
    "Day": {
      "properties": {
        "condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Condition"
        },
        "date": {
          "title": "Date",
          "type": "string"
        },
        "high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "High"
        },
        "kind": {
          "const": "forecast",
          "default": "forecast",
          "title": "Kind",
          "type": "string"
        },
        "low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Low"
        },
        "precipitation": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Precipitation"
        },
        "rain_probability_pct": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rain Probability Pct"
        },
        "sunrise": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sunrise"
        },
        "sunset": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sunset"
        }
      },
      "required": [
        "date",
        "high",
        "low",
        "rain_probability_pct",
        "precipitation",
        "condition",
        "sunrise",
        "sunset"
      ],
      "title": "Day",
      "type": "object"
    },
    "EdgeVoicePayload": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "errors": {
          "default": 0,
          "minimum": 0,
          "title": "Errors",
          "type": "integer"
        },
        "input_level_rms": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Input Level Rms",
          "type": "number"
        },
        "metrics": {
          "additionalProperties": {
            "type": "number"
          },
          "maxProperties": 16,
          "title": "Metrics",
          "type": "object"
        },
        "microphone": {
          "default": false,
          "title": "Microphone",
          "type": "boolean"
        },
        "muted": {
          "default": true,
          "title": "Muted",
          "type": "boolean"
        },
        "speaker": {
          "default": false,
          "title": "Speaker",
          "type": "boolean"
        },
        "state": {
          "enum": [
            "STARTING",
            "IDLE",
            "WAKE_DETECTED",
            "LISTENING",
            "UPLOADING",
            "TRANSCRIBING",
            "THINKING",
            "TOOL_EXECUTING",
            "SYNTHESIZING",
            "DELIVERING",
            "SPEAKING",
            "FOLLOW_UP",
            "ERROR"
          ],
          "title": "State",
          "type": "string"
        },
        "vad_ready": {
          "default": false,
          "title": "Vad Ready",
          "type": "boolean"
        },
        "wake_ready": {
          "default": false,
          "title": "Wake Ready",
          "type": "boolean"
        }
      },
      "required": [
        "state"
      ],
      "title": "EdgeVoicePayload",
      "type": "object"
    },
    "EventPage": {
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "minimum": 0,
          "title": "Cursor",
          "type": "integer"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/SemanticEvent"
          },
          "title": "Events",
          "type": "array"
        },
        "version": {
          "const": 1,
          "default": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "cursor",
        "events"
      ],
      "title": "EventPage",
      "type": "object"
    },
    "Forecast": {
      "properties": {
        "cache_age_seconds": {
          "default": 0,
          "title": "Cache Age Seconds",
          "type": "number"
        },
        "current": {
          "$ref": "#/$defs/Current"
        },
        "daily": {
          "items": {
            "$ref": "#/$defs/Day"
          },
          "title": "Daily",
          "type": "array"
        },
        "fetched_at": {
          "title": "Fetched At",
          "type": "string"
        },
        "freshness_ttl_seconds": {
          "default": 600,
          "exclusiveMinimum": 0,
          "title": "Freshness Ttl Seconds",
          "type": "number"
        },
        "hourly": {
          "items": {
            "$ref": "#/$defs/Hour"
          },
          "title": "Hourly",
          "type": "array"
        },
        "location": {
          "$ref": "#/$defs/Location"
        },
        "measurement_units": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Measurement Units",
          "type": "object"
        },
        "source": {
          "const": "open-meteo",
          "default": "open-meteo",
          "title": "Source",
          "type": "string"
        },
        "source_age_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Age Seconds"
        },
        "source_timestamp": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Timestamp"
        },
        "stale": {
          "default": false,
          "title": "Stale",
          "type": "boolean"
        },
        "units": {
          "enum": [
            "imperial",
            "metric"
          ],
          "title": "Units",
          "type": "string"
        },
        "valid_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Valid From"
        },
        "valid_until": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Valid Until"
        },
        "version": {
          "const": 1,
          "default": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "location",
        "units",
        "measurement_units",
        "current",
        "hourly",
        "daily",
        "fetched_at",
        "source_timestamp",
        "valid_from",
        "valid_until"
      ],
      "title": "Forecast",
      "type": "object"
    },
    "Hour": {
      "properties": {
        "humidity_pct": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Humidity Pct"
        },
        "kind": {
          "const": "forecast",
          "default": "forecast",
          "title": "Kind",
          "type": "string"
        },
        "precipitation": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Precipitation"
        },
        "rain_probability_pct": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rain Probability Pct"
        },
        "temperature": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Temperature"
        },
        "time": {
          "title": "Time",
          "type": "string"
        }
      },
      "required": [
        "time",
        "temperature",
        "humidity_pct",
        "rain_probability_pct",
        "precipitation"
      ],
      "title": "Hour",
      "type": "object"
    },
    "Location": {
      "additionalProperties": false,
      "properties": {
        "latitude": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude",
          "type": "number"
        },
        "name": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "timezone": {
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "name",
        "latitude",
        "longitude",
        "timezone"
      ],
      "title": "Location",
      "type": "object"
    },
    "NightSchedule": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "end": {
          "default": "07:00",
          "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
          "title": "End",
          "type": "string"
        },
        "percent": {
          "default": 25,
          "maximum": 100,
          "minimum": 0,
          "title": "Percent",
          "type": "integer"
        },
        "start": {
          "default": "22:00",
          "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
          "title": "Start",
          "type": "string"
        },
        "timezone": {
          "default": "UTC",
          "title": "Timezone",
          "type": "string"
        }
      },
      "title": "NightSchedule",
      "type": "object"
    },
    "PresenceOptions": {
      "additionalProperties": false,
      "properties": {
        "absence_timeout": {
          "default": 120.0,
          "maximum": 86400,
          "minimum": 0,
          "title": "Absence Timeout",
          "type": "number"
        },
        "absent_confirm": {
          "default": 5.0,
          "maximum": 300,
          "minimum": 0,
          "title": "Absent Confirm",
          "type": "number"
        },
        "activity_grace": {
          "default": 15.0,
          "maximum": 3600,
          "minimum": 0,
          "title": "Activity Grace",
          "type": "number"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "manual_override_seconds": {
          "default": 300.0,
          "maximum": 86400,
          "minimum": 1,
          "title": "Manual Override Seconds",
          "type": "number"
        },
        "minimum_awake": {
          "default": 15.0,
          "maximum": 3600,
          "minimum": 0,
          "title": "Minimum Awake",
          "type": "number"
        },
        "night": {
          "$ref": "#/$defs/NightSchedule"
        },
        "preferred_percent": {
          "default": 65,
          "maximum": 100,
          "minimum": 0,
          "title": "Preferred Percent",
          "type": "integer"
        },
        "present_confirm": {
          "default": 1.0,
          "maximum": 60,
          "minimum": 0,
          "title": "Present Confirm",
          "type": "number"
        },
        "unknown_policy": {
          "default": "awake",
          "enum": [
            "awake",
            "hold"
          ],
          "title": "Unknown Policy",
          "type": "string"
        },
        "wake_cooldown": {
          "default": 2.0,
          "maximum": 60,
          "minimum": 0,
          "title": "Wake Cooldown",
          "type": "number"
        }
      },
      "title": "PresenceOptions",
      "type": "object"
    },
    "PresenceReading": {
      "additionalProperties": false,
      "properties": {
        "health": {
          "default": "unavailable",
          "enum": [
            "healthy",
            "timeout",
            "unavailable",
            "malformed",
            "disabled"
          ],
          "title": "Health",
          "type": "string"
        },
        "state": {
          "default": "UNKNOWN",
          "enum": [
            "PRESENT",
            "ABSENT",
            "UNKNOWN"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "title": "PresenceReading",
      "type": "object"
    },
    "PresenceStatus": {
      "additionalProperties": false,
      "properties": {
        "acknowledged_percent": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acknowledged Percent"
        },
        "activity_protected": {
          "default": false,
          "title": "Activity Protected",
          "type": "boolean"
        },
        "confirmed": {
          "default": "UNKNOWN",
          "enum": [
            "PRESENT",
            "ABSENT",
            "UNKNOWN"
          ],
          "title": "Confirmed",
          "type": "string"
        },
        "display": {
          "default": "unknown",
          "enum": [
            "awake",
            "asleep",
            "unknown"
