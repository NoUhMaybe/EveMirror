# Copy to server.env; generate two DIFFERENT tokens (at least 32 ASCII characters).
# The placeholders deliberately fail validation.
EVE_SERVER_OPERATOR_TOKEN=<operator-token>
EVE_SERVER_EDGE_TOKENS={"mirror-1":"<device-token>"}
EVE_SERVER_COMMAND_TIMEOUT=5
EVE_SERVER_HEARTBEAT_TIMEOUT=45
EVE_SERVER_AUDIO_TIMEOUT=10
EVE_SERVER_AUDIO_MAX_SECONDS=30
EVE_SERVER_MAX_AUDIO_CONSUMERS=2

# Text agent: models are explicit; no inference request occurs before a text turn.
# Replace this with a locally installed, tool-capable model before using /api/agent/turn.
EVE_SERVER_LLM_PROVIDER=ollama
EVE_SERVER_OLLAMA_BASE_URL=http://127.0.0.1:11434
# EVE_SERVER_OLLAMA_MODEL=<installed-tool-capable-model>
EVE_SERVER_ALLOW_CLOUD=false
EVE_SERVER_LLM_TIMEOUT=45
EVE_SERVER_LLM_MAX_OUTPUT_TOKENS=1024
# Optional, model-dependent; leave unset to use the provider's default.
# EVE_SERVER_LLM_TEMPERATURE=0.2
# EVE_SERVER_OLLAMA_THINK=true
# EVE_SERVER_OPENAI_REASONING_EFFORT=low
# For cloud inference explicitly set ALLOW_CLOUD=true and LLM_PROVIDER, then:
# EVE_SERVER_OPENAI_MODEL=<chosen-tool-capable-model>
# EVE_SERVER_OPENAI_API_KEY=<backend-only-secret>
# EVE_SERVER_ANTHROPIC_MODEL=<chosen-tool-capable-model>
# EVE_SERVER_ANTHROPIC_API_KEY=<backend-only-secret>
# No automatic provider fallback is implemented.

EVE_SERVER_AGENT__MAX_TOOL_CALLS=8
EVE_SERVER_AGENT__MAX_TOOL_ROUNDS=4
EVE_SERVER_AGENT__TOOL_TIMEOUT=10
EVE_SERVER_AGENT__TURN_TIMEOUT=90
EVE_SERVER_AGENT__MAX_ARGUMENT_BYTES=8192
EVE_SERVER_AGENT__MAX_RESULT_BYTES=16384
EVE_SERVER_AGENT__MAX_CONTEXT_BYTES=131072
EVE_SERVER_AGENT__MAX_CONTEXT_MESSAGES=64
EVE_SERVER_AGENT__SESSION_IDLE_SECONDS=60
EVE_SERVER_AGENT__MAX_SESSIONS=128
EVE_SERVER_AGENT__MAX_TURNS_PER_SESSION=64
EVE_SERVER_AGENT__ALLOW_MUTATIONS=false
# Optional trusted CLI/service clients, never browser credentials. Generate distinct tokens.
# EVE_SERVER_AGENT_CLIENTS={"terminal":{"token":"<32+-character-token>","device_ids":["mirror-1"],"allow_mutations":false}}
# Optional trusted administrator instructions (not a permission mechanism).
# EVE_SERVER_AGENT_PROMPT_SUFFIX=

# MCP is disabled by default. Prefer dedicated, least-privilege service credentials.
EVE_SERVER_MCP_SERVERS=[]
# Remote endpoints require HTTPS except loopback. These commented examples aren't contacted.
# EVE_SERVER_MCP_SERVERS=[{"name":"approved","transport":"streamable_http","url":"https://mcp.example.invalid/mcp","bearer_token":"<backend-only-secret>","connect_timeout":10,"allowed_tools":{"lookup":{"description":"Look up approved data.","permission":"read_only","mutates":false,"requires_confirmation":false,"timeout":10}}}]
# Local stdio requires a trusted administrator-chosen executable and exact arguments.
# EVE_SERVER_MCP_SERVERS=[{"name":"approved","transport":"stdio","command":"/opt/approved/bin/python","args":["/opt/approved/server.py"],"env":{},"allowed_tools":{"lookup":{"description":"Look up approved data."}}}]
