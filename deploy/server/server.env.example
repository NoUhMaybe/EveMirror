# Copy to server.env; generate two DIFFERENT tokens (at least 32 ASCII characters).
# The placeholders deliberately fail validation.
EVE_SERVER_OPERATOR_TOKEN=<operator-token>
EVE_SERVER_EDGE_TOKENS={"mirror-1":"<device-token>"}
EVE_SERVER_COMMAND_TIMEOUT=5
EVE_SERVER_HEARTBEAT_TIMEOUT=45
EVE_SERVER_AUDIO_TIMEOUT=10
EVE_SERVER_AUDIO_MAX_SECONDS=30
EVE_SERVER_MAX_AUDIO_CONSUMERS=2
