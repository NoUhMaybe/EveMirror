# Copy to server.env; generate two DIFFERENT tokens (at least 32 ASCII characters).
# The placeholders deliberately fail validation.
EVE_SERVER_OPERATOR_TOKEN=<operator-token>
EVE_SERVER_EDGE_TOKENS={"mirror-1":"<device-token>"}
EVE_SERVER_COMMAND_TIMEOUT=5
EVE_SERVER_HEARTBEAT_TIMEOUT=45
EVE_SERVER_AUDIO_TIMEOUT=10
EVE_SERVER_AUDIO_MAX_SECONDS=30
EVE_SERVER_MAX_AUDIO_CONSUMERS=2

# Text agent: models are explicit; no inference request occurs before a text turn.
# Replace this with a locally installed, tool-capable model before using /api/agent/turn.
EVE_SERVER_LLM_PROVIDER=ollama
EVE_SERVER_OLLAMA_BASE_URL=http://127.0.0.1:11434
# EVE_SERVER_OLLAMA_MODEL=<installed-tool-capable-model>
EVE_SERVER_ALLOW_CLOUD=false
EVE_SERVER_LLM_TIMEOUT=45
EVE_SERVER_LLM_MAX_OUTPUT_TOKENS=1024
# Optional, model-dependent; leave unset to use the provider's default.
# EVE_SERVER_LLM_TEMPERATURE=0.2
# EVE_SERVER_OLLAMA_THINK=true
# EVE_SERVER_OPENAI_REASONING_EFFORT=low
# For cloud inference explicitly set ALLOW_CLOUD=true and LLM_PROVIDER, then:
# EVE_SERVER_OPENAI_MODEL=<chosen-tool-capable-model>
# EVE_SERVER_OPENAI_API_KEY=<backend-only-secret>
# EVE_SERVER_ANTHROPIC_MODEL=<chosen-tool-capable-model>
# EVE_SERVER_ANTHROPIC_API_KEY=<backend-only-secret>
# No automatic provider fallback is implemented.

EVE_SERVER_AGENT__MAX_TOOL_CALLS=8
EVE_SERVER_AGENT__MAX_TOOL_ROUNDS=4
EVE_SERVER_AGENT__TOOL_TIMEOUT=10
EVE_SERVER_AGENT__TURN_TIMEOUT=90
EVE_SERVER_AGENT__MAX_ARGUMENT_BYTES=8192
EVE_SERVER_AGENT__MAX_RESULT_BYTES=16384
EVE_SERVER_AGENT__MAX_CONTEXT_BYTES=131072
EVE_SERVER_AGENT__MAX_CONTEXT_MESSAGES=64
EVE_SERVER_AGENT__SESSION_IDLE_SECONDS=60
EVE_SERVER_AGENT__MAX_SESSIONS=128
EVE_SERVER_AGENT__MAX_TURNS_PER_SESSION=64
EVE_SERVER_AGENT__ALLOW_MUTATIONS=false
# Optional trusted CLI/service clients, never browser credentials. Generate distinct tokens.
# EVE_SERVER_AGENT_CLIENTS={"terminal":{"token":"<32+-character-token>","device_ids":["mirror-1"],"allow_mutations":false}}
# Optional trusted administrator instructions (not a permission mechanism).
# EVE_SERVER_AGENT_PROMPT_SUFFIX=

# MCP is disabled by default. Prefer dedicated, least-privilege service credentials.
EVE_SERVER_MCP_SERVERS=[]
# Remote endpoints require HTTPS except loopback. These commented examples aren't contacted.
# EVE_SERVER_MCP_SERVERS=[{"name":"approved","transport":"streamable_http","url":"https://mcp.example.invalid/mcp","bearer_token":"<backend-only-secret>","connect_timeout":10,"allowed_tools":{"lookup":{"description":"Look up approved data.","permission":"read_only","mutates":false,"requires_confirmation":false,"timeout":10}}}]
# Local stdio requires a trusted administrator-chosen executable and exact arguments.
# EVE_SERVER_MCP_SERVERS=[{"name":"approved","transport":"stdio","command":"/opt/approved/bin/python","args":["/opt/approved/server.py"],"env":{},"allowed_tools":{"lookup":{"description":"Look up approved data."}}}]

# Persistent backend state. Compose overrides DATABASE_PATH to its named volume.
EVE_SERVER_DATABASE_PATH=data/server.sqlite3
EVE_SERVER_DATABASE_BUSY_MS=5000
EVE_SERVER_MAX_OPERATIONS=100000
EVE_SERVER_EVENT_RETENTION=10000
EVE_SERVER_TIMERS__MAX_ACTIVE=128
EVE_SERVER_TIMERS__MAX_DURATION_SECONDS=604800
EVE_SERVER_TIMERS__RECONCILE_SECONDS=30
# Creating/changing timers and explicit views uses the existing mutation gate above.

# Weather fetches occur only when requested by a tool; no startup/unrelated-chat fetch.
EVE_SERVER_WEATHER__ENABLED=true
EVE_SERVER_WEATHER__LOCATION=Frisco, Texas, USA
EVE_SERVER_WEATHER__LATITUDE=33.1507
EVE_SERVER_WEATHER__LONGITUDE=-96.8236
EVE_SERVER_WEATHER__TIMEZONE=America/Chicago
EVE_SERVER_WEATHER__UNITS=imperial
EVE_SERVER_WEATHER__FORECAST_URL=https://api.open-meteo.com/v1/forecast
EVE_SERVER_WEATHER__GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
EVE_SERVER_WEATHER__CURRENT_TTL=600
EVE_SERVER_WEATHER__DAILY_TTL=3600
EVE_SERVER_WEATHER__WEEKLY_TTL=10800
EVE_SERVER_WEATHER__MAX_STALE=86400
EVE_SERVER_WEATHER__MAX_LOCATIONS=32
EVE_SERVER_WEATHER__TIMEOUT=8

# Home Assistant is disabled until endpoint, token and approved entities are supplied.
# These are illustrative entity IDs, never assumed to exist in your installation.
# EVE_SERVER_HOME__URL=https://ha.example.invalid
# EVE_SERVER_HOME__TOKEN=<backend-only-home-assistant-token>
EVE_SERVER_HOME__ALLOW_INSECURE_LAN=false
EVE_SERVER_HOME__TIMEOUT=5
EVE_SERVER_HOME__DISCOVERY_TTL=10
EVE_SERVER_HOME__ENTITIES={}
# EVE_SERVER_HOME__ENTITIES={"light.example_bedroom":{"aliases":["bedroom lights"],"actions":["turn_on","turn_off","set_level"]},"media_player.example_tv":{"aliases":["TV"],"actions":["power","play","pause","set_volume","send_remote_command"],"remote_entity":"remote.example_tv","remote_commands":{"HOME":"home","BACK":"back"}}}
# Scoped clients must also explicitly receive home_entities; operators see approved IDs.
# EVE_SERVER_AGENT_CLIENTS={"terminal":{"token":"<distinct-32+-character-token>","device_ids":["mirror-1"],"allow_mutations":true,"home_entities":["light.example_bedroom"]}}
# Insecure trusted-LAN HA HTTP needs its own explicit allow flag; MCP TLS is unchanged.

# Optional fixed SearXNG JSON endpoint; no result pages or user URLs are fetched.
# EVE_SERVER_SEARCH__URL=https://search.example.invalid/search
# EVE_SERVER_SEARCH__TOKEN=<optional-backend-only-bearer-token>
EVE_SERVER_SEARCH__ALLOW_INSECURE_LAN=false
EVE_SERVER_SEARCH__TIMEOUT=8
EVE_SERVER_SEARCH__MAX_RESULTS=5

# Optional local speech. Model loading never downloads assets at runtime.
EVE_SERVER_SPEECH__ENABLED=false
EVE_SERVER_VOICE_DEVICES={}
# Explicit device-to-agent policy; does not copy operator privileges to a microphone.
# EVE_SERVER_VOICE_DEVICES={"mirror-1":{"allow_mutations":false,"home_entities":[]}}
# Approved low-risk voice actions also need AGENT__ALLOW_MUTATIONS=true.
# Home IDs must already be approved in HOME__ENTITIES.
# EVE_SERVER_VOICE_DEVICES={"mirror-1":{"allow_mutations":true,"home_entities":["light.example_bedroom"]}}
EVE_SERVER_SPEECH__ASSET_ROOT=/opt/eve/assets
# EVE_SERVER_SPEECH__ASSET_MANIFEST=/opt/eve/assets/server-manifest.json
EVE_SERVER_SPEECH__STT_ENGINE=faster_whisper
EVE_SERVER_SPEECH__STT_MODEL_DIRECTORY=whisper
EVE_SERVER_SPEECH__STT_DEVICE=cpu
EVE_SERVER_SPEECH__STT_COMPUTE_TYPE=int8
EVE_SERVER_SPEECH__STT_LANGUAGE=en
EVE_SERVER_SPEECH__CPU_THREADS=4
EVE_SERVER_SPEECH__STT_TIMEOUT=45
EVE_SERVER_SPEECH__TTS_ENGINE=piper
EVE_SERVER_SPEECH__TTS_TIMEOUT=30
EVE_SERVER_SPEECH__SPEAKER_ID=0
EVE_SERVER_SPEECH__LENGTH_SCALE=1.06
EVE_SERVER_SPEECH__NOISE_SCALE=0.58
EVE_SERVER_SPEECH__NOISE_W_SCALE=0.82
EVE_SERVER_SPEECH__MAX_TEXT=4000
EVE_SERVER_SPEECH__MAX_RESPONSE_SECONDS=60
EVE_SERVER_SPEECH__PLAYBACK_TIMEOUT=8
EVE_SERVER_SPEECH__FOLLOW_UP_SECONDS=60
EVE_SERVER_SPEECH__ALARM_POLL_SECONDS=1
EVE_SERVER_SPEECH__VOICE_EVENT_TTL=60
EVE_SERVER_SPEECH__WARMUP=false
# Caption and voice-owned widget access is a separate explicit client grant.
# EVE_SERVER_AGENT_CLIENTS={"trusted-service":{"token":"<distinct-32+-character-token>","device_ids":["mirror-1"],"allow_voice_state":true}}
# Never put this service token or the operator token into a browser bundle.

# Phase 6 browser. Disabled until exact origins and device grants are reviewed.
EVE_SERVER_BROWSER__ENABLED=false
EVE_SERVER_BROWSER__ORIGINS=[]
EVE_SERVER_BROWSER__DEVICES={}
EVE_SERVER_BROWSER__ALLOW_HTTP_LOOPBACK=false
EVE_SERVER_BROWSER__SESSION_SECONDS=2592000
EVE_SERVER_BROWSER__PAIRING_SECONDS=300
EVE_SERVER_BROWSER__MAX_SESSIONS=128
# The container builds/serves /app/dashboard automatically. Source installs:
# EVE_SERVER_BROWSER__STATIC_ROOT=apps/dashboard/dist
# EVE_SERVER_BROWSER__ORIGINS=["https://mirror.example.invalid"]
# Browsers read only their assigned voice principal; optional privileges default false.
# EVE_SERVER_BROWSER__DEVICES={"mirror-1":{"captions":true,"timers":true,"voice_control":true,"home_control":false,"debug":false,"home_entities":[]}}
# Timers/home mutations additionally require AGENT__ALLOW_MUTATIONS=true.
# Home IDs must be a subset of HOME__ENTITIES. Browser pairing never grants shell,
# arbitrary HA services, serial/GPIO access, MCP administration or provider settings.
# Phase 7 optionally grants finite display policy changes through the edge arbiter:
# add "display_control":true to the specific device grant, and explicitly enable
# AGENT__ALLOW_MUTATIONS. Default is false. No browser raw hardware interface exists.
