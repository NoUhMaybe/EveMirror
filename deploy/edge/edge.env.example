# The matching device token comes from the backend's edge_tokens mapping.
EVE_EDGE_DEVICE_ID=mirror-1
EVE_EDGE_SERVER_URL=wss://eve.example.internal
EVE_EDGE_TOKEN=<device-token>
EVE_EDGE_ALLOW_INSECURE_LAN=false
# Set a verified stable /dev/serial/by-id/... data interface, not the REPL interface.
EVE_EDGE_SERIAL_PORT=/dev/serial/by-id/<verified-data-interface>
EVE_EDGE_SERIAL_TIMEOUT=1
EVE_EDGE_SIMULATE_HARDWARE=false
EVE_EDGE_JOURNAL_PATH=/var/lib/evemirror/edge-commands.sqlite3
EVE_EDGE_HEARTBEAT_INTERVAL=10
EVE_EDGE_RECONNECT_MIN=1
EVE_EDGE_RECONNECT_MAX=30

# Phase 7 local policy. No physical sensor protocol is enabled or assumed.
EVE_EDGE_PRESENCE_DRIVER=none
EVE_EDGE_PRESENCE_POLL_INTERVAL=0.2
EVE_EDGE_PRESENCE_READ_TIMEOUT=1
EVE_EDGE_PRESENCE_RECONNECT_INTERVAL=5
# Use one JSON value to preserve strict booleans/numbers. Defaults remain disabled.
# EVE_EDGE_PRESENCE={"enabled":true,"preferred_percent":65,"present_confirm":1.0,"absent_confirm":5.0,"absence_timeout":120.0,"minimum_awake":15.0,"wake_cooldown":2.0,"activity_grace":15.0,"manual_override_seconds":300.0,"unknown_policy":"awake","night":{"enabled":false,"timezone":"UTC","start":"22:00","end":"07:00","percent":25}}
# Simulations only: PRESENCE_DRIVER=simulated with SIMULATE_HARDWARE=true.
# Saved settings/manual expiry/uncertain-write latch live in the existing edge journal.

# Opt-in local capture/playback; does not launch the legacy listener.
EVE_EDGE_VOICE__ENABLED=false
EVE_EDGE_VOICE__ASSET_ROOT=/opt/evemirror/assets
# EVE_EDGE_VOICE__ASSET_MANIFEST=/opt/evemirror/assets/edge-manifest.json
EVE_EDGE_VOICE__STATE_PATH=/var/lib/evemirror/edge-voice.sqlite3
# Exact unique PortAudio name, or explicitly unstable index:2; unset uses OS default.
# EVE_EDGE_VOICE__INPUT_DEVICE=<unique-microphone-name>
# EVE_EDGE_VOICE__OUTPUT_DEVICE=<unique-speaker-name>
# Unset rates use device defaults, with real SoXR conversion to/from the wire format.
# EVE_EDGE_VOICE__CAPTURE_RATE=48000
# EVE_EDGE_VOICE__OUTPUT_RATE=48000
EVE_EDGE_VOICE__CAPTURE_CHANNELS=1
EVE_EDGE_VOICE__GAIN=1
EVE_EDGE_VOICE__VOLUME=0.7
EVE_EDGE_VOICE__WAKE_THRESHOLD=0.5
EVE_EDGE_VOICE__WAKE_HITS=2
EVE_EDGE_VOICE__WAKE_COOLDOWN=3
EVE_EDGE_VOICE__VAD_THRESHOLD=0.5
EVE_EDGE_VOICE__MIN_SPEECH_MS=320
EVE_EDGE_VOICE__SILENCE_MS=800
EVE_EDGE_VOICE__INITIAL_TIMEOUT=5
EVE_EDGE_VOICE__MAX_UTTERANCE_SECONDS=15
EVE_EDGE_VOICE__PRE_ROLL_MS=160
EVE_EDGE_VOICE__ECHO_COOLDOWN=0.4
EVE_EDGE_VOICE__CHIME_COOLDOWN=0.05
EVE_EDGE_VOICE__FOLLOW_UP_SECONDS=60
EVE_EDGE_VOICE__QUEUE_BLOCKS=32
# Safe default; explicit --unmute changes the saved preference for this runtime.
# Set MUTED_ON_START=false to permit that saved unmuted preference on later starts.
EVE_EDGE_VOICE__MUTED_ON_START=true
EVE_EDGE_VOICE__OFFLINE_ALARMS=true
EVE_EDGE_VOICE__OFFLINE_LEASE_SECONDS=86400
EVE_EDGE_VOICE__ALARM_RECEIPT_LIMIT=10000
EVE_EDGE_VOICE__TRANSFER_TIMEOUT=10
EVE_EDGE_VOICE__TURN_TIMEOUT=180
